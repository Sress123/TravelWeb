@model TravelWeb.Models.Accommodation
@{
    ViewData["Title"] = "Add Accommodation";
}

<div class="container py-5 mt-5" style="max-width: 700px;">
    <div class="mb-4">
        <h2 class="fw-bold mt-1 text-uppercase">Add Accommodation</h2>
    </div>

    <form asp-action="Create" method="post">
        <input asp-for="TourId" type="hidden" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Location</label>
            <input asp-for="Location" class="form-control" placeholder="e.g. Kathmandu" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Type</label>
            <input asp-for="Type" class="form-control" placeholder="e.g. Hotel, Lodge, Resort" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Number of Nights</label>
            <input asp-for="NoOfNight" type="number" class="form-control" placeholder="e.g. 3" min="1" />
            <span asp-validation-for="NoOfNight" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Abbreviation</label>
            <input asp-for="Abbreviation" class="form-control" placeholder="e.g. BB, HB, FB" />
            <span asp-validation-for="Abbreviation" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-danger px-4">Save</button>
            <a asp-controller="Tours" asp-action="Details"
               asp-route-id="@Model.TourId"
               class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}