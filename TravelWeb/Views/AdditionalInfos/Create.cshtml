@model TravelWeb.Models.AdditionalInfo
@{
    ViewData["Title"] = "Add Additional Info";
}

<div class="container py-5 mt-5" style="max-width: 700px;">
    <div class="mb-4">
        <h2 class="fw-bold mt-1 text-uppercase">Add Additional Info</h2>
    </div>

    <form asp-action="Create" method="post">
        <input asp-for="TourId" type="hidden" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Title</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. Visa Information" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Sub Title</label>
            <input asp-for="SubTitle" class="form-control" placeholder="e.g. Required Documents" />
            <span asp-validation-for="SubTitle" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Description</label>
            <textarea asp-for="Description" class="form-control" rows="5"
                      placeholder="Enter detailed description..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-danger px-4">Save</button>
            <a asp-controller="Tours" asp-action="Details"
               asp-route-id="@Model.TourId"
               class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}