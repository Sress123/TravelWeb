@model TravelWeb.Models.DatePrice
@{
    ViewData["Title"] = "Add Date & Price";
}

<div class="container py-5 mt-5" style="max-width: 700px;">
    <h2 class="fw-bold mb-4">Add Date & Price</h2>

    <form asp-action="Create" method="post">

        <input asp-for="Id" type="hidden" />
        <input asp-for="TourId" type="hidden" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" required />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" required />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Price (USD)</label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Price" class="form-control" placeholder="e.g. 1400" required />
                <span class="input-group-text">USD</span>
            </div>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-danger px-4">Save</button>
            <a asp-controller="Tours" asp-action="Details"
               asp-route-id="@Model.TourId"
               class="btn btn-outline-secondary px-4">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}