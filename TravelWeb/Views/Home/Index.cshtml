@{
    ViewData["Title"] = "Home Page";
}

<style>
    #dealsRow::-webkit-scrollbar {
        display: none;
    }
</style>

<!-- Hero Carousel — full viewport height -->
<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">

    <!-- Indicators -->
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3"></button>
    </div>

    <!-- Slides -->
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/carousel/1.jpg" class="d-block w-100 carousel-img" alt="Slide 1" />
            <div class="carousel-caption">
                <h1 class="carousel-title">Trekking in Nepal</h1>
                <a asp-controller="Destinations" asp-action="Index" class="btn btn-danger btn-lg px-4">View More →</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/carousel/2.jpg" class="d-block w-100 carousel-img" alt="Slide 2" />
            <div class="carousel-caption">
                <h1 class="carousel-title">Explore Tibet</h1>
                <a asp-controller="Destinations" asp-action="Index" class="btn btn-danger btn-lg px-4">View More →</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/carousel/3.jpg" class="d-block w-100 carousel-img" alt="Slide 3" />
            <div class="carousel-caption">
                <h1 class="carousel-title">Discover Bhutan</h1>
                <a asp-controller="Destinations" asp-action="Index" class="btn btn-danger btn-lg px-4">View More →</a>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/carousel/4.jpg" class="d-block w-100 carousel-img" alt="Slide 4" />
            <div class="carousel-caption">
                <h1 class="carousel-title">Adventure in India</h1>
                <a asp-controller="Destinations" asp-action="Index" class="btn btn-danger btn-lg px-4">View More →</a>
            </div>
        </div>

    </div>

    <!-- Prev / Next Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- Content below carousel -->
<div class="container py-5 pb-0">
    <div class="text-center mb-4">
        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">About Us</small>
        <h2 class="fw-bold mt-2">Experience Exploring The Best</h2>
        <div style="width:60px; height:3px; background-color:#c0392b; margin:0 auto;"></div>
    </div>
    <p class="mx-auto" style="max-width: 990px; font-size:14px; font-weight:bold; text-align: justify;">
        Established by some of the most knowledgeable and experienced tourism professionals in the
        region, Asiatic Roads is an alliance of operators from South Asia that specializes in providing
        high end customized travel and tour packages in Nepal, Tibet, Bhutan, India and Bangladesh.
        We offer tailor made cultural heritage tours to areas away from the crowd and adventure expeditions
        and treks in regions far from the trodden trails conducted in the most sustainable manner.
        Whether it is special interest groups searching for particular flora and fauna or a peek at regions,
        cultures and traditions hidden from popular packages our experts are ready to ensure your trip is an
        experience you will cherish forever.
    </p>
    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="About" class="btn btn-outline-danger px-4" style="font-size:15px; font-weight:bold;">
            View More →
        </a>
    </div>
</div>

<!-- Best Deals Section -->
<div class="container-fluid py-5">
    <div class="text-center mb-4">
        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Top Picks</small>
        <h2 class="fw-bold mt-1 text-uppercase">Best Deal's</h2>
        <div style="width:60px; height:3px; background-color:#c0392b; margin:0 auto;"></div>
    </div>

    <div style="position:relative;">
        <!-- Scrollable Row -->
        <div id="dealsRow" style="display:flex; gap:16px; overflow-x:auto; scroll-behavior:smooth; padding: 10px 60px; scrollbar-width:none;">
            @foreach (var tour in ViewBag.Tours)
            {
                <a asp-controller="Tours" asp-action="Details"
                   asp-route-id="@tour.Id"
                   style="min-width:300px; max-width:320px; border-radius:12px; overflow:hidden; position:relative; flex-shrink:0; text-decoration:none; display:block;">
                    <img src="@tour.PhotoPath"
                         style="width:100%; height:340px; object-fit:cover; display:block;" alt="@tour.Title" />
                    <div style="position:absolute; bottom:0; left:0; right:0; padding:1.2rem; background:linear-gradient(transparent, rgba(0,0,0,0.80));">
                        <h6 class="text-white fw-bold mb-1" style="font-size:0.95rem;">@tour.Title</h6>
                        <small class="text-white opacity-75"><i class="fa fa-clock-o me-1"></i>@tour.Duration</small>
                    </div>
                </a>
            }
        </div>

        <!-- Prev Button -->
        <button onclick="document.getElementById('dealsRow').scrollLeft -= 300"
                style="position:absolute; left:10px; top:50%; transform:translateY(-50%); width:40px; height:40px; border-radius:50%; background:#fff; border:none; box-shadow:0 2px 8px rgba(0,0,0,0.2); font-size:20px; cursor:pointer; z-index:10;">
            ‹
        </button>

        <!-- Next Button -->
        <button onclick="document.getElementById('dealsRow').scrollLeft += 300"
                style="position:absolute; right:10px; top:50%; transform:translateY(-50%); width:40px; height:40px; border-radius:50%; background:#fff; border:none; box-shadow:0 2px 8px rgba(0,0,0,0.2); font-size:20px; cursor:pointer; z-index:10;">
            ›
        </button>
    </div>
    <div class="text-center mt-4">
        <a asp-controller="Destinations" asp-action="Index" class="btn btn-outline-danger px-4" style="font-size:15px; font-weight:bold;">
            View More →
        </a>
    </div>
</div>

<!-- Customize Your Trip Section -->
<div class="container-fluid py-0" style="background:#f5f5f5;">
    <div class="row g-0 align-items-stretch">

        <!-- Left: Diamond-arrow shaped image -->
        <div class="col-lg-5 p-0" style="position:relative; min-height:400px; overflow:hidden;">
            <img src="~/images/carousel/5.png"
                 style="width:100%; height:100%; object-fit:cover; position:absolute; top:0; left:0;" />
            <!-- Arrow clip overlay on right side -->
            <div style="position:absolute; top:0; right:-1px; width:50px; height:100%;
                        background:#f5f5f5;
                        clip-path: polygon(100% 0%, 0% 50%, 100% 100%);"></div>
        </div>

        <!-- Right: Text -->
        <div class="col-lg-7 d-flex align-items-center py-5 px-5" style="background:#f5f5f5;">
            <div style="padding-left: 80px;>
                <small class="text-muted" style="letter-spacing:2px; font-size:13px;">Customize Your Trip</small>
                <h2 class="fw-bold mt-2 mb-3" style="font-size:2.8rem; line-height:1.2; color:#111;">
                    Customize your trip <br />with an expert trip <br />designer
                </h2>
                <p class="text-muted mb-4" style="font-size:15px; max-width:420px;">
                    Book your trip when it is perfectly designed and customized, just for you.
                </p>
                <div class="d-flex flex-column gap-3" style="max-width:300px;">
                    <a href="https://wa.me/9779843056391" target="_blank"
                       class="btn btn-danger px-4 py-2 fw-semibold">
                        <i class="fa-brands fa-whatsapp me-2"></i>+977 9843056391 →
                    </a>
                    <a asp-controller="Destinations" asp-action="Index"
                       class="btn px-4 py-2 fw-semibold"
                       style="border:2px solid #c0392b; color:#c0392b; background:transparent;">
                        Customize Your Trip →
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="container py-5">
    <div style="display:flex; align-items:stretch; border-radius: 12px; overflow:hidden; box-shadow: 0 2px 16px rgba(0,0,0,0.10);">

        <!-- E-Brochure -->
        <a asp-controller="Home" asp-action="eBook" style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding: 2.5rem 1rem; text-decoration:none; position:relative; overflow:hidden; border-right: 1px solid rgba(255,255,255,0.2);">
            <div style="position:absolute; inset:0; background: linear-gradient(135deg, #1a1a2e 0%, #c0392b 100%); opacity:0.92;"></div>
            <div style="position:absolute; inset:0; background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=400&q=60'); background-size:cover; background-position:center; opacity:0.25;"></div>
            <div style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:10px;">
                <i class="fa fa-book" style="font-size:42px; color:#fff;"></i>
                <span style="font-size:16px; color:#fff; font-weight:600; letter-spacing:1px;">E-Brochure</span>
                <span style="font-size:13px; color:rgba(255,255,255,0.7);">Download PDF</span>
            </div>
        </a>

        <!-- Reviews -->
        <div style="flex:2; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding: 2.5rem 1rem; background:#fff; border-right: 1px solid #e0e0e0;">
            <span style="font-size:16px; color:#333; font-weight:600;">Write Us Your Reviews</span>
            <div style="display:flex; gap:4px;">
                <i class="fa fa-star" style="font-size:30px; color:#00b67a;"></i>
                <i class="fa fa-star" style="font-size:30px; color:#00b67a;"></i>
                <i class="fa fa-star" style="font-size:30px; color:#00b67a;"></i>
                <i class="fa fa-star" style="font-size:30px; color:#00b67a;"></i>
                <i class="fa fa-star" style="font-size:30px; color:#00b67a;"></i>
            </div>
            <a asp-controller="Home" asp-action="Reviews" style="font-size:14px; color:#c0392b; text-decoration:none; font-weight:600; border: 1px solid #c0392b; padding: 6px 18px; border-radius:20px;">Leave a Review →</a>
        </div>

        <!-- Contact Us -->
        <a asp-controller="Home" asp-action="Contact" style="flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding: 2.5rem 1rem; text-decoration:none; position:relative; overflow:hidden; border-left: 1px solid rgba(255,255,255,0.2);">
            <div style="position:absolute; inset:0; background: linear-gradient(135deg, #1a1a2e 0%, #2c3e50 100%); opacity:0.92;"></div>
            <div style="position:absolute; inset:0; background-image: url('https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=400&q=60'); background-size:cover; background-position:center; opacity:0.25;"></div>
            <div style="position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; gap:10px;">
                <i class="fa fa-envelope" style="font-size:42px; color:#fff;"></i>
                <span style="font-size:16px; color:#fff; font-weight:600; letter-spacing:1px;">Contact Us</span>
                <span style="font-size:13px; color:rgba(255,255,255,0.7);">Get in Touch</span>
            </div>
        </a>

    </div>
</div>