@model IEnumerable<TravelWeb.Models.Review>
@{
    ViewData["Title"] = "Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    main {
        padding-top: 40px;
    }
</style>

<!-- Breadcrumb -->
<div class="container-fluid px-4 py-2 mt-5 pt-4" style="border-bottom: 1px solid #ddd;">
    <nav>
        <a href="/" class="text-dark text-decoration-none">Home</a>
        <span class="mx-2">/</span>
        <span class="text-muted">Reviews</span>
    </nav>
</div>

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <small class="text-muted text-uppercase" style="letter-spacing: 3px;">What People Say</small>
            <h2 class="fw-bold mt-1">CUSTOMER REVIEWS</h2>
            <div style="width: 60px; height: 3px; background-color: #c0392b;"></div>
        </div>
        <button class="btn btn-danger px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#reviewModal">
            <i class="fa fa-pen me-2"></i> Write a Review
        </button>
    </div>

    <!-- Review Cards from DB -->
    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var review in Model)
            {
                <div class="col-md-4">
                    <div class="p-4 rounded bg-white h-100" style="border: 1px solid #ebebeb; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
                        <div class="text-warning mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa fa-star@(i <= (review.Rating ?? 0) ? "" : "-o")"></i>
                            }
                        </div>
                        <h6 class="fw-bold">@review.Title</h6>
                        <p class="text-muted mb-3" style="font-size: 0.9rem; text-align: justify;">
                            @review.Reviewtext
                        </p>
                        <small class="text-muted fw-semibold">— @review.Authorname</small>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fa fa-comment-o" style="font-size:48px; color:#ddd;"></i>
            <p class="text-muted mt-3">No reviews yet. Be the first to write one!</p>
        </div>
    }
</div>

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content p-2">

            <div class="modal-header border-0">
                <h4 class="modal-title fw-bold">WRITE US YOUR REVIEW</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-controller="Home" asp-action="SubmitReview" method="post">
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your overall rating</label>
                        <div class="star-rating">
                            <i class="fa fa-star star" data-value="1"></i>
                            <i class="fa fa-star star" data-value="2"></i>
                            <i class="fa fa-star star" data-value="3"></i>
                            <i class="fa fa-star star" data-value="4"></i>
                            <i class="fa fa-star star" data-value="5"></i>
                        </div>
                        <input type="hidden" name="Rating" id="ratingValue" value="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title of your review</label>
                        <input type="text" name="Title" class="form-control" placeholder="Summarize your review" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your review</label>
                        <textarea name="Reviewtext" class="form-control" rows="5" placeholder="Tell people your review" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Your name & Country</label>
                            <input type="text" name="Authorname" class="form-control" placeholder="Your name, country" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Your email</label>
                            <input type="email" name="Authoremail" class="form-control" placeholder="Your email" required />
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" name="isgenuine"
                                   style="width: 50px; height: 25px;" />
                        </div>
                        <label style="font-size: 0.9rem;">
                            This review is based on my own experience and is my genuine opinion.
                        </label>
                    </div>

                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">Submit Review</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const stars = document.querySelectorAll('.star');
        const ratingValue = document.getElementById('ratingValue');

        stars.forEach(star => {
            star.addEventListener('mouseover', function () {
                highlightStars(this.getAttribute('data-value'));
            });
            star.addEventListener('mouseleave', function () {
                highlightStars(ratingValue.value);
            });
            star.addEventListener('click', function () {
                ratingValue.value = this.getAttribute('data-value');
                highlightStars(ratingValue.value);
            });
        });

        function highlightStars(value) {
            stars.forEach(star => {
                star.style.color = star.getAttribute('data-value') <= value ? '#f5a623' : '#ccc';
            });
        }

        highlightStars(0);
    </script>
}