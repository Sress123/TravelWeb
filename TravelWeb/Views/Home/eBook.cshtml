@{
    ViewData["Title"] = "E-Brochure";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-5 mt-5">
    <div class="text-center mb-3">
        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Download</small>
        <h2 class="fw-bold mt-1 text-uppercase">E-Brochure</h2>
        <div style="width:60px; height:3px; background-color:#c0392b; margin: 0 auto;"></div>
    </div>

    <div style="background:#555; padding: 10px; border-radius:8px;">
        <iframe src="@Url.Content("~/file/booklet.pdf")"
                width="100%"
                height="500px"
                style="border:none; border-radius:4px;">
        </iframe>
    </div>

    <div class="mt-3 text-center">
        <a href="@Url.Content("~/file/booklet.pdf")" download class="btn btn-danger px-4">
            <i class="fa fa-download me-1"></i> Download Brochure
        </a>
    </div>
</div>