@model TravelWeb.Models.Itinerary
@{
    ViewData["Title"] = Model.Id == 0 ? "Add Itinerary Day" : "Edit Itinerary Day";
}

<div class="container py-5 mt-5" style="max-width: 700px;">

    <div class="mb-4">
        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Itinerary</small>
        <h2 class="fw-bold mt-1">@ViewData["Title"]</h2>
        <div style="width: 60px; height: 3px; background-color: #c0392b;"></div>
    </div>

    <form asp-action="Create" asp-controller="Itineraries" method="post">

        <input asp-for="Id" type="hidden" />
        <input asp-for="TourId" type="hidden" />

        <div class="mb-3">
            <label class="form-label fw-semibold">Day Number</label>
            <input asp-for="DayNumber" type="number" class="form-control" min="1" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Day Title</label>
            <input asp-for="Title" class="form-control"
                   placeholder="e.g. Arrival in Kathmandu" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Description</label>
            <textarea asp-for="Description" class="form-control" rows="7"
                      placeholder="Describe what happens on this day..."></textarea>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-danger px-4">
                @(Model.Id == 0 ? "Save Day" : "Save Changes")
            </button>
            <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>

    </form>
</div>