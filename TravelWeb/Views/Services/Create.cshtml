@model TravelWeb.Models.Service
@{
    ViewData["Title"] = "Add Services";
}

<div class="container py-5 mt-5" style="max-width: 700px;">
    <h2 class="fw-bold mb-4">Add Services Include & Exclude</h2>

    <form asp-action="Create" method="post">

        <input asp-for="Id" type="hidden" />
        <input asp-for="TourId" type="hidden" />

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="fa fa-check-circle text-success me-1"></i> Included Services
            </label>
            <textarea asp-for="IncludeServices" class="form-control" rows="6"
                      placeholder="Enter each included service on a new line..."></textarea>
            <small class="text-muted">One service per line</small>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">
                <i class="fa fa-times-circle text-danger me-1"></i> Excluded Services
            </label>
            <textarea asp-for="NotIncludeServices" class="form-control" rows="6"
                      placeholder="Enter each excluded service on a new line..."></textarea>
            <small class="text-muted">One service per line</small>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-danger px-4">Save</button>
            <a asp-controller="Tours" asp-action="Details"
               asp-route-id="@Model.TourId"
               class="btn btn-outline-secondary px-4">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}