@model IEnumerable<TravelWeb.Models.Tour>
@{
    ViewData["Title"] = "All Tours";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-5" style="margin-top: 80px;">
    <div class="row">

        <!-- LEFT: Filters -->
        <div class="col-lg-3 col-md-4 mb-4">
            <form method="get" asp-controller="TopTours" asp-action="Index">
                <div style="border: 1px solid #e0e0e0; border-radius:10px; padding:1.5rem; background:#fff;">

                    <!-- Destination -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">Destination</h6>
                            <i class="fa fa-chevron-up text-muted"></i>
                        </div>
                        <select name="destination" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Destinations</option>
                            @foreach (var d in ViewBag.Destinations)
                            {
                                <option value="@d" selected="@(ViewBag.SelectedDestination == d ? "selected" : null)">@d</option>
                            }
                        </select>
                    </div>

                    <!-- Region -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">Regions</h6>
                            <i class="fa fa-chevron-up text-muted"></i>
                        </div>
                        <select name="region" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Regions</option>
                            @foreach (var r in ViewBag.Regions)
                            {
                                <option value="@r" selected="@(ViewBag.SelectedRegion == r ? "selected" : null)">@r</option>
                            }
                        </select>
                    </div>

                    <!-- Difficulty / Grade -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">Difficulty</h6>
                            <i class="fa fa-chevron-up text-muted"></i>
                        </div>
                        <select name="grade" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">All Levels</option>
                            @foreach (var g in ViewBag.Grades)
                            {
                                <option value="@g" selected="@(ViewBag.SelectedGrade == g ? "selected" : null)">@g</option>
                            }
                        </select>
                    </div>

                    <!-- Duration -->
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">Duration</h6>
                            <i class="fa fa-chevron-up text-muted"></i>
                        </div>
                        <select name="duration" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="">Any Duration</option>
                            <option value="1" selected="@(ViewBag.SelectedDuration == "1" ? "selected" : null)">1-5 Days</option>
                            <option value="7" selected="@(ViewBag.SelectedDuration == "7" ? "selected" : null)">7+ Days</option>
                            <option value="14" selected="@(ViewBag.SelectedDuration == "14" ? "selected" : null)">14+ Days</option>
                            <option value="21" selected="@(ViewBag.SelectedDuration == "21" ? "selected" : null)">21+ Days</option>
                        </select>
                    </div>

                    <!-- Clear Filters -->
                    <a asp-controller="TopTours" asp-action="Index"
                       class="btn btn-outline-danger btn-sm w-100 mt-3">
                        <i class="fa fa-times me-1"></i> Clear Filters
                    </a>

                </div>
            </form>
        </div>

        <!-- RIGHT: Tour Cards -->
        <div class="col-lg-9 col-md-8">

            <div class="text-center mb-4">
                <small class="text-muted text-uppercase" style="letter-spacing:3px;">Explore</small>
                <h4 class="fw-bold mt-1">
                    All Tours
                    <span class="text-muted fs-6 fw-normal ms-2">(@Model.Count() found)</span>
                </h4>
                <div style="width:60px; height:3px; background-color:#c0392b; margin:0 auto;"></div>
            </div>

            @if (Model.Any())
            {
                <div class="row g-4">
                    @foreach (var tour in Model)
                    {
                        <div class="col-md-6 col-lg-3 d-flex">
                            <a asp-controller="Tours" asp-action="Details"
                               asp-route-id="@tour.Id"
                               style="text-decoration:none; color:inherit; width:100%;">
                                <div style="border:1px solid #e0e0e0; border-radius:10px; overflow:hidden; background:#fff; transition: box-shadow 0.2s; height:100%; display:flex; flex-direction:column;"
                                     onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.12)'"
                                     onmouseout="this.style.boxShadow='none'">
                                    <img src="@tour.PhotoPath"
                                         style="width:100%; height:200px; object-fit:cover; flex-shrink:0;" alt="@tour.Title" />
                                    <div class="p-3" style="flex:1;">
                                        <h6 class="fw-bold text-uppercase mb-1" style="font-size:0.85rem;">@tour.Title</h6>
                                        <small class="text-muted">- Duration @tour.Duration</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa fa-search" style="font-size:48px; color:#ddd;"></i>
                    <p class="text-muted mt-3">No tours found matching your filters.</p>
                    <a asp-controller="TopTours" asp-action="Index" class="btn btn-outline-danger">Clear Filters</a>
                </div>
            }

        </div>
    </div>
</div>