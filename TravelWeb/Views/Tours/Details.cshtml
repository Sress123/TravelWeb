@model TravelWeb.Models.Tour
@{
    ViewData["Title"] = @Model.Title;
}

<style>
    .contact-img {
        height: 80vh;
        object-fit: cover;
        object-position: center;
        filter: brightness(0.6);
    }

    .sticky-card {
        position: sticky;
        top: 90px;
    }

    .tab-nav {
        background-color: #2d2d2d;
        position: sticky;
        top: 95px;
        z-index: 1020;
    }

    .tab-nav .nav-link {
        color: #ccc !important;
        border-radius: 0;
        padding: 14px 20px;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .tab-nav .nav-link.active {
        color: #c0392b !important;
        background-color: transparent;
        border-bottom: 3px solid #c0392b;
    }

    .tab-nav .nav-link:hover {
        color: white !important;
    }

    .info-label {
        color: #c0392b;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .accordion-button:not(.collapsed) {
        background-color: #f8f8f8;
        color: #000;
        font-weight: bold;
        box-shadow: none;
    }

    .accordion-button:focus {
        box-shadow: none;
    }
</style>

<!-- Hero Image -->
<div style="position: relative;">
    <img src="@Model.PhotoPath" class="d-block w-100 contact-img" alt="Details Page" />
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; text-align: center;">
        <h1 class="text-white fw-bold text-uppercase"
            style="font-size: 3rem; text-shadow: 2px 2px 8px rgba(0,0,0,0.7);">
            @Model.Title
        </h1>
        @if (!string.IsNullOrEmpty(Model.Altitude))
        {
            <p class="text-white" style="font-size:1rem; text-shadow:1px 1px 6px rgba(0,0,0,0.7);">
                @Model.Altitude
            </p>
        }
    </div>
</div>

<!-- Breadcrumb -->
<div class="container-fluid px-4 py-2" style="border-bottom:1px solid #ddd;">
    <div class="d-flex justify-content-between align-items-center">
        <nav>
            <a href="/" class="text-dark text-decoration-none">Home</a>
            <span class="mx-2">/</span>
            @if (Model.Destination != null)
            {
                <a asp-controller="Destinations" asp-action="Details"
                   asp-route-id="@Model.DestinationId"
                   class="text-dark text-decoration-none">
                    @Model.Destination.Country
                </a>
                <span class="mx-2">/</span>
                <span class="text-muted me-2">@Model.Destination.Destinationcategory</span>
                <span class="mx-2">/</span>
            }
            <span class="text-danger">@Model.Title</span>
        </nav>
    </div>
</div>

<!-- Tour Info Grid -->
<div class="container py-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-hiking fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Activities:</div>
                    <div>@Model.Destination?.Destinationcategory</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-map-marker-alt fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Region:</div>
                    <div>@Model.Region</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-calendar fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Duration:</div>
                    <div>@Model.Duration</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-route fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Trek Style:</div>
                    <div>@Model.Grade</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-snowflake fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Best Seasons:</div>
                    <div>@Model.BestSeasons</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-mountain fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Highest Elevation:</div>
                    <div>@Model.Altitude</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-signal fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Grade:</div>
                    <div>@Model.Grade</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <i class="fa fa-hotel fa-lg text-dark mt-1"></i>
                <div>
                    <div class="info-label">Accommodation:</div>
                    <div>@Model.Accommodation</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tab Navigation -->
<div class="tab-nav sticky-top">
    <ul class="nav nav-tabs border-0 container" id="tourTabs">
        <li class="nav-item">
            <a class="nav-link active" href="#overview" onclick="showTab('overview')">
                OVERVIEW & ITINERARY
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#dates" onclick="showTab('dates')">
                DATE & PRICES
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#accommodation" onclick="showTab('accommodation')">
                ACCOMMODATIONS
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#additional" onclick="showTab('additional')">
                ADDITIONAL INFORMATION
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#gallery" onclick="showTab('gallery')">
                GALLERY
            </a>
        </li>
        <li class="nav-item ms-auto d-flex align-items-center gap-3 pe-3">

            <!-- Phone -->
            <a href="tel:+9779843056391" class="text-white text-decoration-none">
                <i class="fa fa-phone"></i>
            </a>

            <!-- Email -->
            <a href="mailto:info@prabeenGole.com" class="text-white text-decoration-none">
                <i class="fa fa-envelope"></i>
            </a>

        </li>
    </ul>
</div>

<!-- Main Content + Sidebar -->
<div class="container py-5">
    <div class="row g-4">

        <!-- Left Content -->
        <div class="col-md-8">

            <!-- OVERVIEW & ITINERARY -->
            <div id="tab-overview">
                <p style="text-align:justify; line-height:1.9;">@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.RouteMapPhotoPath))
                {
                    <div class="mt-5">
                        <div class="mb-3">
                            <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Map</small>
                            <h4 class="fw-bold mt-1">ROUTE MAP</h4>
                            <div style="width: 60px; height: 3px; background-color: #c0392b;"></div>
                        </div>
                        <img src="@Model.RouteMapPhotoPath" class="w-100 rounded shadow-sm"
                             alt="Route Map" style="object-fit: cover;" />
                    </div>
                }

                <!-- Itinerary Accordion -->
                @if (Model.Itineraries.Any())
                {
                    <div class="mt-5 mb-3">
                        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Day by Day</small>
                        <h4 class="fw-bold mt-1">ITINERARY IN DETAIL</h4>
                        <div style="width: 60px; height: 3px; background-color: #c0392b;"></div>
                    </div>

                    <div class="accordion mt-4" id="itineraryAccordion">
                        @foreach (var day in Model.Itineraries.OrderBy(i => i.DayNumber))
                        {
                            <div class="accordion-item border-0 border-bottom">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed fw-semibold"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#day@(day.DayNumber)">
                                        <span class="me-2 text-danger">Day @day.DayNumber:</span>
                                        @day.Title
                                    </button>
                                </h2>
                                <div id="day@(day.DayNumber)" class="accordion-collapse collapse"
                                     data-bs-parent="#itineraryAccordion">
                                    <div class="accordion-body text-muted" style="text-align:justify;">
                                        @day.Description
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- Admin: Add Itinerary -->
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <div class="mt-3">
                        <a asp-controller="Itineraries" asp-action="Create"
                           asp-route-tourId="@Model.Id"
                           class="btn btn-outline-danger btn-sm">
                            <i class="fa fa-plus me-1"></i> Add Itinerary Day
                        </a>
                    </div>
                }
            </div>

            <!-- DATE & PRICES -->
            <div id="tab-dates" style="display:none;">
                @if (Model.DatePrices.Any())
                {
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr class="text-center align-middle">
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Price</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dp in Model.DatePrices)
                            {
                                <tr class="text-center align-middle">
                                    <td>@dp.StartDate</td>
                                    <td>@dp.EndDate</td>
                                    <td>@dp.Price USD</td>
                                    <td class="text-center align-middle">
                                        <a asp-controller="Bookings" asp-action="Create"
                                           asp-route-datePriceId="@dp.Id"
                                           asp-route-tourId="@Model.Id"
                                           class="btn btn-danger btn-sm">
                                            Book Now →
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No dates added yet.</p>
                }
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="DatePrices" asp-action="Create"
                       asp-route-tourId="@Model.Id"
                       class="btn btn-outline-danger btn-sm mt-2">
                        <i class="fa fa-plus me-1"></i> Add Date & Price
                    </a>
                }

                <!-- SERVICES SHOWN BELOW DATES -->
                @if (Model.Services.Any())
                {
                    var service = Model.Services.First();
                    <hr class="my-4" />
                    <div class="mb-4 mt-4">
                        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Services</small>
                        <h2 class="fw-bold mt-1 text-uppercase">What's Included & Excluded</h2>
                        <div style="width:60px; height:3px; background-color:#c0392b;"></div>
                    </div>

                    <h6 class="fw-bold mt-3">Services Included</h6>
                    <ul class="list-unstyled">
                        @foreach (var item in service.IncludeServices?.Split('\n') ?? Array.Empty<string>())
                        {
                            <li class="mb-2">
                                <i class="fa fa-check-circle text-success me-2"></i>@item
                            </li>
                        }
                    </ul>

                    <h6 class="fw-bold mt-4">Services Excluded</h6>
                    <ul class="list-unstyled">
                        @foreach (var item in service.NotIncludeServices?.Split('\n') ?? Array.Empty<string>())
                        {
                            <li class="mb-2">
                                <i class="fa fa-times-circle text-danger me-2"></i>@item
                            </li>
                        }
                    </ul>
                }
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="Services" asp-action="Create"
                       asp-route-tourId="@Model.Id"
                       class="btn btn-outline-danger btn-sm mt-2">
                        <i class="fa fa-plus me-1"></i> Add Services
                    </a>
                }
            </div>

            <!-- ACCOMMODATIONS -->
            <div id="tab-accommodation" style="display:none;">
                @if (Model.Accommodations.Any())
                {
                    <table class="table table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>Location</th>
                                <th>Type</th>
                                <th>No. of Nights</th>
                                <th>Abbreviation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acc in Model.Accommodations)
                            {
                                <tr>
                                    <td>@acc.Location</td>
                                    <td>@acc.Type</td>
                                    <td>@acc.NoOfNight</td>
                                    <td>@acc.Abbreviation</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No accommodations added yet.</p>
                }
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="Accommodations" asp-action="Create"
                       asp-route-tourId="@Model.Id"
                       class="btn btn-outline-danger btn-sm mt-2">
                        <i class="fa fa-plus me-1"></i> Add Accommodation
                    </a>
                }
            </div>

            <!-- ADDITIONAL INFORMATION -->
            <div id="tab-additional" style="display:none;">
                @if (Model.AdditionalInfos.Any())
                {
                    <div class="mb-4 mt-4">
                        <small class="text-muted text-uppercase" style="letter-spacing: 3px;">Tour Details</small>
                        <h2 class="fw-bold mt-1 text-uppercase">Additional Information</h2>
                        <div style="width:60px; height:3px; background-color:#c0392b;"></div>
                    </div>
                    <div class="accordion" id="additionalInfoAccordion">
                        @foreach (var info in Model.AdditionalInfos)
                        {
                            <div class="border-top py-3">
                                <div class="d-flex justify-content-between align-items-center"
                                     style="cursor:pointer;"
                                     data-bs-toggle="collapse"
                                     data-bs-target="#info-@info.Id">
                                    <span class="fw-semibold fs-6">@info.Title</span>
                                    <i class="fa fa-chevron-down text-danger"></i>
                                </div>
                                <div id="info-@info.Id" class="collapse">
                                    <div class="pt-3 pb-2">
                                        @if (!string.IsNullOrEmpty(info.SubTitle))
                                        {
                                            <h6 class="text-muted fw-semibold">@info.SubTitle</h6>
                                        }
                                        <p class="text-muted mb-0" style="text-align:justify;">@info.Description</p>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="border-top"></div>
                    </div>
                }
                else
                {
                    <p class="text-muted">No additional information added yet.</p>
                }
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="AdditionalInfos" asp-action="Create"
                       asp-route-tourId="@Model.Id"
                       class="btn btn-outline-danger btn-sm mt-3">
                        <i class="fa fa-plus me-1"></i> Add Information
                    </a>
                }
            </div>

            <!-- GALLERY -->
            <div id="tab-gallery" style="display:none;">
                @if (Model.Gallaries.Any())
                {
                    <div class="row g-3">
                        @foreach (var photo in Model.Gallaries)
                        {
                            <div class="col-md-4">
                                <img src="@photo.PhotoPath" class="w-100 rounded"
                                     style="height:200px; object-fit:cover;" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No gallery photos added yet.</p>
                }
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="Gallary" asp-action="Create"
                       asp-route-tourId="@Model.Id"
                       class="btn btn-outline-danger btn-sm mt-3">
                        <i class="fa fa-plus me-1"></i> Add Photo
                    </a>
                }
            </div>

        </div>

        <!-- Right Sidebar -->
        <div class="col-md-4">
            <div class="sticky-card">

                <!-- Price Card -->
                <div class="card border-0 shadow-lg p-4 mb-3">
                    <p class="fw-semibold mb-0">@Model.Duration From</p>
                    <h2 class="fw-bold mt-1">
                        @if (Model.DatePrices.Any())
                        {
                            <span>@Model.DatePrices.First().Price</span>
                            <small class="fs-6 text-muted fw-normal"> USD</small>
                        }
                        else
                        {
                            <span class="text-muted fs-5">Price on request</span>
                        }
                    </h2>

                    <a asp-controller="Bookings" asp-action="Create" asp-route-datePriceId="@Model.DatePrices.FirstOrDefault()?.Id"
                       asp-route-tourId="@Model.Id" class="btn btn-success w-100 mb-2 mt-2">
                        Book Now →
                    </a>
                    <a asp-controller="Tours" asp-action="DownloadPdf"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger w-100">
                        Download Trip Dossier →
                    </a>
                </div>

                <!-- Admin Actions -->
                @if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <div class="card border-0 shadow-sm p-3 mb-3">
                        <div class="d-flex gap-2">
                            <a asp-controller="Tours" asp-action="Create"
                               asp-route-id="@Model.Id"
                               asp-route-destinationId="@Model.DestinationId"
                               class="btn btn-outline-primary btn-sm flex-fill">
                                <i class="fa fa-pen me-1"></i> Edit
                            </a>
                            <a asp-controller="Tours" asp-action="Delete"
                               asp-route-id="@Model.Id"
                               asp-route-destinationId="@Model.DestinationId"
                               class="btn btn-outline-danger btn-sm flex-fill"
                               onclick="return confirm('Delete this tour?')">
                                <i class="fa fa-trash me-1"></i> Delete
                            </a>
                        </div>
                    </div>
                }

                <!-- Company Card -->
                <div class="card border-0 shadow-lg p-4 text-center">
                    <img src="~/images/logo.png" height="60" alt="Logo" class="mx-auto mb-2" />
                    <p class="fw-semibold mb-1">Any Question?</p>
                    <small class="text-muted">Feel free to call our travel experts.</small>
                    <div class="mt-3">
                        <p class="mb-1">
                            <i class="fa fa-phone text-danger me-2"></i>
                            +977 9843056391
                        </p>
                        <p class="mb-0">
                            <i class="fa fa-envelope text-danger me-2"></i>
                            info@prabeenGole.com
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('[id^="tab-"]').forEach(tab => {
                tab.style.display = 'none';
            });

            // Remove active from all nav links
            document.querySelectorAll('.tab-nav .nav-link').forEach(link => {
                link.classList.remove('active');
            });

            // Show selected tab
            document.getElementById('tab-' + tabName).style.display = 'block';

            // Set active nav link
            event.target.classList.add('active');
        }
    </script>
}